{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/.well-known/assetlinks.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/baixar",
      "destination": "/#/install",
      "permanent": false
    },
    {
      "source": "/apk",
      "destination": "https://github.com/jamesismos/coliseuax-timer/releases/latest/download/ColiseuAX-Timer-AndroidTV.apk",
      "permanent": false
    },
    {
      "source": "/webos",
      "destination": "https://github.com/jamesismos/coliseuax-timer/releases/latest/download/ColiseuAX-Timer-webOS.ipk",
      "permanent": false
    },
    {
      "source": "/tizen",
      "destination": "https://github.com/jamesismos/coliseuax-timer/releases/latest/download/ColiseuAX-Timer-Tizen-projeto.zip",
      "permanent": false
    }
  ]
}
